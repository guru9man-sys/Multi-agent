# Multi-Agent System Configuration
# Copy this file to .env and fill in your actual values

# ===== API KEYS =====
TAVILY_API_KEY=your_tavily_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
QWEN_API_KEY=your_qwen_api_key_here

# ===== LOCAL LLM CONFIGURATION =====
# Phase 7.4: Configurable Local LLM Selection
# Provider options: 'ollama', 'vllm'
LOCAL_LLM_PROVIDER=ollama

# For Ollama: qwen2.5, llama3, mistral, phi, neural-chat, etc.
# For vLLM: meta-llama/Llama-2-7b-hf, mistralai/Mistral-7B-Instruct-v0.1, etc.
LOCAL_LLM_MODEL=qwen2.5

# Endpoint URL for your Local LLM
# Ollama default: http://localhost:11434
# vLLM default: http://localhost:8000
LOCAL_LLM_ENDPOINT=http://localhost:11434

# Timeout for Local LLM requests (seconds)
LOCAL_LLM_TIMEOUT=60

# Enable/Disable Local LLM for routing (true/false)
# If disabled, will use Cloud LLM (OpenAI/Gemini) for routing
USE_LOCAL_LLM_ROUTING=true

# ===== DATABASE =====
DATABASE_URL=sqlite:///agent_system.db

# ===== ENVIRONMENT =====
# Options: development, production
ENV=development

# ===== LOGGING =====
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ===== SYSTEM SETTINGS =====
DEFAULT_PRIORITY=medium
DEFAULT_PLATFORM=linkedin

# ===== TIMEOUTS (seconds) =====
SEARCH_TIMEOUT=10
LLM_TIMEOUT=30
