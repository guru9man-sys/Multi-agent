# Google API Configuration for AccountingDataAgent
# Add these to your .env file

# Path to the service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/your/service-account-file.json

# OR provide the JSON content directly as a string
# GOOGLE_SERVICE_ACCOUNT_INFO='{"type": "service_account", "project_id": "..."}'

# The ID of the Google Sheet where summaries should be appended
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# The ID of the Google Drive folder where files should be uploaded
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Default upload target: 'google_drive', 'google_sheet', 'google_drive_and_sheet', or 'local_excel'
GOOGLE_UPLOAD_DEFAULT_TARGET=google_drive_and_sheet
